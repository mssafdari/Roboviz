<?xml version="1.0"?>
<robot name="scara_robot">
    <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    <material name="yellow"><color rgba="1 1 0 1"/></material>
    <material name="orange"><color rgba="1 0.5 0 1"/></material>

    <!-- Base -->
    <link name="base_link">
        <visual>
            <geometry><cylinder radius="0.15" length="0.1"/></geometry>
            <material name="grey"/>
        </visual>
    </link>

    <!-- Joint 1: Base to Link1 (rotation about Z) -->
    <joint name="joint1" type="revolute">
        <parent link="base_link"/>
        <child link="link1"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="50" velocity="2.0"/>
    </joint>
    <link name="link1">
        <visual>
            <geometry><cylinder radius="0.05" length="0.3"/></geometry>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <material name="yellow"/>
        </visual>
    </link>

    <!-- Joint 2: Link1 to Link2 (rotation about Z) -->
    <joint name="joint2" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <origin xyz="0 0 0.3" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="50" velocity="2.0"/>
    </joint>
    <link name="link2">
        <visual>
            <geometry><cylinder radius="0.04" length="0.25"/></geometry>
            <origin xyz="0 0 0.125" rpy="0 0 0"/>
            <material name="orange"/>
        </visual>
    </link>

    <!-- Joint 3: Link2 to Link3 (prismatic - Z motion) -->
    <joint name="joint3" type="prismatic">
        <parent link="link2"/>
        <child link="link3"/>
        <origin xyz="0 0 0.25" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="0.2" effort="50" velocity="0.5"/>
    </joint>
    <link name="link3">
        <visual>
            <geometry><cylinder radius="0.03" length="0.15"/></geometry>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
    </link>

    <!-- Joint 4: Link3 to End Effector (rotation about Z - wrist) -->
    <joint name="joint4" type="revolute">
        <parent link="link3"/>
        <child link="end_effector"/>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="20" velocity="3.0"/>
    </joint>
    <link name="end_effector">
        <visual>
            <geometry><cylinder radius="0.02" length="0.05"/></geometry>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <material name="yellow"/>
        </visual>
    </link>
</robot>
