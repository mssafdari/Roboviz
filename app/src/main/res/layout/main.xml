<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">

    <!-- Top TextView scrollable area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight=".8"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/myText"
            android:text="@string/hello_world"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"/>
    </ScrollView>

    <!-- Bottom Horizontal ScrollView -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="horizontal">

        <!-- Child LinearLayout with wrap_content width -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/testButton"
                android:text="Test"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:gravity="center"/>

            <Button
                android:id="@+id/goToRobotButton"
                android:text="joint-sliders"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/so3label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="test so3:"
                android:textSize="18sp"
                android:layout_marginEnd="16dp"/>

            <ToggleButton
                android:id="@+id/toggleSo3t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textOn="ON"
                android:textOff="OFF"
                android:checked="false" />

            <TextView
                android:id="@+id/se3label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="test se3:"
                android:textSize="18sp"
                android:layout_marginEnd="16dp"/>

            <ToggleButton
                android:id="@+id/toggleSe3t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textOn="ON"
                android:textOff="OFF"
                android:checked="false" />

            <TextView
                android:id="@+id/kinematicslabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="test kin:"
                android:textSize="18sp"
                android:layout_marginEnd="16dp"/>

            <ToggleButton
                android:id="@+id/toggleKinematicst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textOn="ON"
                android:textOff="OFF"
                android:checked="false" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
